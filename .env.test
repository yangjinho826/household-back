# 테스트 전용 설정 — docker-compose.test.yml 의 postgres-test 를 가리킴.
# 더미 크레덴셜(휘발성 컨테이너)이라 커밋해도 안전. conftest.py 최상단에서 os.environ 로 주입.
DATABASE_URL=postgresql+asyncpg://test:test@127.0.0.1:55432/test_household
JWT_SECRET=test-secret-key-at-least-32-characters-long-000
APP_NAME=household-test
DEBUG=false
DB_POOL_MIN=5
DB_POOL_MAX=10
DB_POOL_TIMEOUT=10
COOKIE_SECURE=false
ALLOWED_ORIGINS=["*"]
