# =============================================
# 애플리케이션
# =============================================
APP_NAME=household
DEBUG=false                              # 운영은 false. 로컬 dev 만 true
DOCKER_IMAGE_NAME=household-back
DOCKER_CONTAINER_NAME=household-back

# =============================================
# 데이터베이스
# =============================================
# 운영/docker: 강력한 PASSWORD 로 교체
POSTGRES_USER=household
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=HOUSEHOLD
# docker-compose 가 DATABASE_URL 을 자동 합성 (postgres 호스트). 로컬 dev 면 127.0.0.1 로 덮어쓰기.
DATABASE_URL=postgresql+asyncpg://household:change-me-strong-password@postgres:5432/HOUSEHOLD
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_POOL_TIMEOUT=30

# =============================================
# 로깅
# =============================================
LOG_LEVEL=INFO

# =============================================
# CORS
# =============================================
# 운영 도메인 화이트리스트 (JSON 배열). 단일 도메인이면 same-origin 이라 안전망 역할.
# 형식: 큰따옴표 + JSON 배열, 콤마로 여러 origin 구분 (콜론 포함 시도 다 큰따옴표).
# 예: ALLOWED_ORIGINS=["https://household.jinho826.com","https://admin.jinho826.com"]
ALLOWED_ORIGINS=["https://your-domain.example.com"]

# =============================================
# JWT
# =============================================
# 운영 시 반드시 강력한 secret 으로 교체: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-256-bits-long-secret-for-hs256
JWT_EXPIRATION=1800                       # access token: 30분
JWT_REFRESH_EXPIRATION=604800             # refresh token: 7일

# 쿠키 — HTTPS 면 true, HTTP 임시 운영이면 false
COOKIE_SECURE=true

# =============================================
# DB 백업 (Cloudflare R2) — infra/backup/ 참고
# =============================================
# R2 대시보드 → Manage R2 API Tokens → Create Account API token (Object R&W, 버킷 범위 한정)
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=household-backup

# =============================================
# 장애 알림 — infra/backup/README.md 알림 섹션 참고
# =============================================
# 전부 옵셔널 — 비워두면 알림만 꺼지고 앱/백업은 정상 동작.
# 앱(잡 실패·5xx)이 직접 쏘는 Discord webhook URL. GitHub secret 에도 같은 값 등록 (배포 실패 알림용)
DISCORD_WEBHOOK_URL=
# Healthchecks.io 체크별 ping URL — 백업/리허설 스크립트가 성공 ping, 끊기면 HC 가 Discord 로 알림
HC_PING_URL_BACKUP=
HC_PING_URL_DRILL=
